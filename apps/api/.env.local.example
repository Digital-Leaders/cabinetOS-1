# Contexte local - developpement via Docker Compose (TASK-017)
NODE_ENV=development
DATABASE_URL=postgres://cabinetos_app:cabinetos_app_pw@localhost:5432/cabinetos_dev
PORT=3000

# ADMIN_DATABASE_URL : compte superutilisateur, utilise par le script de
# sauvegarde/restauration (scripts/backup-restore.sh), les migrations, et le
# nettoyage des tests qui inserent dans audit_events (BUILD-002 : cabinetos_app
# n a plus UPDATE/DELETE sur cette table, append-only au niveau base) -- jamais
# par l application elle-meme (voir docs/adr/spike-drizzle-rls.md).
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cabinetos_dev

# Better-Auth (TASK-013) : secret d au moins 32 caracteres, genere localement,
# jamais commite. BETTER_AUTH_TRUSTED_ORIGINS : liste separee par des virgules
# des origines autorisees a appeler /api/v1/auth (protection CSRF integree).
BETTER_AUTH_SECRET=change-me-generate-a-real-32-char-secret
BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# E-mail transactionnel (EA-013, ADR-0020).
# EMAIL_PROVIDER : "memory" (defaut hors production : rien ne part reellement, les
# messages sont captures en memoire) ou "brevo" (obligatoire en production).
EMAIL_PROVIDER=memory
# BREVO_API_KEY : SECRET, requis uniquement si EMAIL_PROVIDER=brevo. Jamais commite,
# jamais colle dans un chat ni dans une capture d'ecran : transmis par canal securise.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@portesante.ma
EMAIL_FROM_NAME=PorteSanté
EMAIL_REPLY_TO=verification@portesante.ma
