# Contexte test - CI et execution locale des tests, base ephemere
NODE_ENV=test
DATABASE_URL=postgres://cabinetos_app:cabinetos_app_pw@localhost:5432/cabinetos_test
PORT=3000

# ADMIN_DATABASE_URL : compte superutilisateur, utilise par le script de
# sauvegarde/restauration (scripts/backup-restore.sh, TASK-012) et par le nettoyage
# des tests qui inserent dans audit_events (BUILD-002 : cabinetos_app n a plus
# UPDATE/DELETE sur cette table, append-only au niveau base). Jamais utilise par
# l application elle-meme -- RLS le contournerait.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cabinetos_test

# Better-Auth (TASK-013)
BETTER_AUTH_SECRET=test-secret-at-least-32-characters-long-ok
BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Adresse publique du site (le front) : cible du lien de l'email d'activation.
APP_BASE_URL=http://localhost:3001
