# Contexte recette - configuration proche de la cible, valeurs a fournir par l environnement reel
NODE_ENV=production
DATABASE_URL=postgres://APP_USER:PASSWORD@HOST:5432/cabinetos_recette
PORT=3000
ADMIN_DATABASE_URL=postgres://ADMIN_USER:PASSWORD@HOST:5432/cabinetos_recette

# Better-Auth (TASK-013) : secret genere pour cet environnement specifiquement,
# jamais reutilise entre environnements.
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
BETTER_AUTH_BASE_URL=https://CHANGE_ME.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://CHANGE_ME_FRONTEND.example.com

# E-mail transactionnel (EA-013, ADR-0020).
# EMAIL_PROVIDER : "brevo" est obligatoire en production (NODE_ENV=production) --
# l'application refuse de demarrer sans lui (env.validation.ts).
EMAIL_PROVIDER=brevo
# BREVO_API_KEY : SECRET, obligatoire avec EMAIL_PROVIDER=brevo. A fournir par
# l'environnement reel ; jamais commite, jamais colle dans un chat ni dans une
# capture d'ecran : transmis par canal securise.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@portesante.ma
EMAIL_FROM_NAME=PorteSanté
EMAIL_REPLY_TO=verification@portesante.ma

# Adresse publique du site (le front), OBLIGATOIRE en production : cible du lien « Se connecter » de l'email d'activation.
APP_BASE_URL=https://CHANGE_ME_FRONTEND.example.com
